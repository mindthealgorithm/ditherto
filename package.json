{
  "name": "ditherto",
  "version": "0.1.0",
  "description": "Pixelate your life by dithering your images to fixed colour palette",
  "keywords": [
    "dithering",
    "image",
    "pixel",
    "palette",
    "graphics"
  ],
  "homepage": "https://github.com/mindthealgorithm/ditherto",
  "bugs": "https://github.com/mindthealgorithm/ditherto/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindthealgorithm/ditherto.git"
  },
  "license": "MIT",
  "author": "Jessey White-Cinis <j@cin.is>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./dom": {
      "import": {
        "types": "./dist/dom.d.ts",
        "default": "./dist/dom.js"
      },
      "require": {
        "types": "./dist/dom.d.cts",
        "default": "./dist/dom.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ditherto": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && rollup -c && node scripts/package-types.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "vitest",
    "test:node": "vitest --config vitest.config.ts",
    "test:browser": "npm run build && playwright test",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.mjs",
    "prepublishOnly": "npm run build",
    "demo": "npm run build && node scripts/serve-demo.mjs",
    "test:dom": "vitest run --config vitest.browser.config.ts",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.8.4",
    "@vitest/coverage-v8": "^2.1.3",
    "jsdom": "^25.0.1",
    "rollup": "^4.24.0",
    "rollup-plugin-dts": "^6.1.1",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.74"
  }
}
